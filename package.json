{
  "name": "juego-asesino",
  "version": "1.0.0",
  "description": "Juego Asesino - Psychological Thriller Multiplayer 3D",
  "main": "main.js",
  "author": "Hugo Uzal",
  "scripts": {
    "start": "electron .",
    "postinstall": "cd server && npm install",
    "build:win": "electron-builder --win"
  },
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.5.4"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.hugouzal.juegoasesino",
    "productName": "Juego Asesino",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "client/**/*",
      "server/**/*",
      "!server/node_modules/**/*",
      "node_modules/**/*",
      "!**/*.map"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
